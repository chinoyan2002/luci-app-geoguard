#!/bin/sh
# countryallow 排程管理：每天／每週日／每月1日＋時分（改 UCI 後跑一次即生效）
CRON_FILE="/etc/crontabs/root"
JOB="/usr/bin/countryallow-update"

sed -i '\#countryallow-update#d' "$CRON_FILE" 2>/dev/null
sed -i '\#countryallow-ddns#d' "$CRON_FILE" 2>/dev/null

# 公司 DDNS 動態白名單：有填才排，每 10 分鐘跟一次，存檔立刻跑一次即生效
if [ -n "$(uci -q get countryallow.main.company_ddns 2>/dev/null)" ]; then
	echo "*/10 * * * * /usr/bin/countryallow-ddns" >> "$CRON_FILE"
	/usr/bin/countryallow-ddns
fi

if [ "$(uci -q get countryallow.main.auto_update)" = "1" ]; then
	FREQ=$(uci -q get countryallow.main.update_freq 2>/dev/null)
	HOUR=$(uci -q get countryallow.main.update_hour)
	MIN=$(uci -q get countryallow.main.update_min)
	[ -z "$HOUR" ] && HOUR=3
	[ -z "$MIN" ] && MIN=10
	case "$FREQ" in
		weekly)  SPEC="$MIN $HOUR * * 0" ;;
		monthly) SPEC="$MIN $HOUR 1 * *" ;;
		*)       SPEC="$MIN $HOUR * * *" ;;
	esac
	echo "$SPEC $JOB" >> "$CRON_FILE"
	logger -t countryallow "已設定排程 $SPEC"
else
	logger -t countryallow "已關閉自動更新"
fi

/etc/init.d/cron restart >/dev/null 2>&1
