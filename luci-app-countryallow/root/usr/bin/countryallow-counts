#!/bin/sh
# countryallow-counts：目前啟用的集合檔行數＋live 段數＋最後更新日期（給設定頁用）
# 輸出：集合名 檔行數 live段數 YYYY-MM-DD_HH:MM:SS（底線分隔，JS 好切）
BASE_DIR="/etc/luci-uploads"
SETNAME=$(uci -q get countryallow.main.setname 2>/dev/null)
echo "$SETNAME" | grep -qE '^[A-Za-z][A-Za-z0-9_-]*$' || SETNAME="allowed-IPList"
FILE="$BASE_DIR/${SETNAME}.cidr"
FL=0
LIVE=0
FDATE="-"
if [ -f "$FILE" ]; then
  FL=$(wc -l < "$FILE")
  FDATE=$(date -r "$FILE" '+%F_%T' 2>/dev/null || echo "-")
fi
if nft list set inet fw4 "$SETNAME" >/dev/null 2>&1; then
  LIVE=$(nft list set inet fw4 "$SETNAME" 2>/dev/null | tr ',' '\n' | grep -c '/')
fi
echo "$SETNAME $FL $LIVE $FDATE"
