#!/bin/sh
# countryallow-status：集合狀態＋更新歷史＋相關系統日誌（給 LuCI 記錄頁用）
BASE_DIR="/etc/luci-uploads"
SETNAME=$(uci -q get countryallow.main.setname 2>/dev/null)
echo "$SETNAME" | grep -qE '^[A-Za-z][A-Za-z0-9_-]*$' || SETNAME="allowed-IPList"
FILE="$BASE_DIR/${SETNAME}.cidr"

echo "===== 集合狀態 ====="
if [ -f "$FILE" ]; then
  echo "集合檔：$FILE（$(wc -l < "$FILE") 行，$(date -r "$FILE" '+%F %T')）"
else
  echo "集合檔：$FILE（不存在，請按立即更新 IP 集合）"
fi
if nft list set inet fw4 "$SETNAME" >/dev/null 2>&1; then
  echo "live set：$(nft list set inet fw4 "$SETNAME" 2>/dev/null | tr ',' '\n' | grep -c '/') 段生效中"
else
  echo "live set：不存在（防火牆重載後才會建立）"
fi
echo "排程：$(grep 'countryallow-update' /etc/crontabs/root 2>/dev/null | head -1)"
echo ""
echo "===== 更新歷史（近 20 筆） ====="
tail -n 20 "$BASE_DIR/history.log" 2>/dev/null || echo "（尚無記錄）"
echo ""
echo "===== 系統日誌（近 15 筆） ====="
logread 2>/dev/null | grep 'countryallow' | tail -n 15 || echo "（尚無記錄）"
