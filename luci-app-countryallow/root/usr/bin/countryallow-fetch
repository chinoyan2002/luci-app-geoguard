#!/bin/sh
# countryallow-fetch：只抓各國 CIDR 檔（不合併、不重載）
# 用途：首次安裝補檔、單獨重新抓源。合併請跑 countryallow-update
BASE_DIR="/etc/luci-uploads"
TEMP_DIR="/tmp/cafetch-$$"

SRC1=$(uci -q get countryallow.main.src_primary 2>/dev/null)
SRC2=$(uci -q get countryallow.main.src_backup 2>/dev/null)
[ -z "$SRC1" ] && SRC1="https://www.ipdeny.com/ipblocks/data/aggregated/{cc}-aggregated.zone"
[ -z "$SRC2" ] && SRC2="https://raw.githubusercontent.com/ipverse/country-ip-blocks/master/country/{cc}/ipv4-aggregated.txt"

SELECTED=""
for l in asia europe africa northamerica southamerica oceania; do
  SELECTED="$SELECTED $(uci -q get countryallow.main.sel_$l 2>/dev/null)"
done
SELECTED="$SELECTED $(uci -q get countryallow.main.selected 2>/dev/null)"

mkdir -p "$BASE_DIR" "$TEMP_DIR"
trap 'rm -rf "$TEMP_DIR"' EXIT

upper() { echo "$1" | tr 'a-z' 'A-Z'; }

fetch_one() {
  local cc="$1" tmp="$TEMP_DIR/${cc}.raw" clean="$TEMP_DIR/${cc}.cidr" url srcname
  for template in "$SRC1" "$SRC2"; do
    [ -z "$template" ] && continue
    url=$(echo "$template" | sed -e "s/{cc}/$cc/g" -e "s/{CC}/$(upper $cc)/g")
    case "$template" in
      *ipdeny*) srcname="主要" ;;
      *) srcname="備用" ;;
    esac
    wget -T 30 -t 2 -q -O "$tmp" "$url" 2>/dev/null || continue
    [ -s "$tmp" ] || continue
    grep -v '^#' "$tmp" > "$clean"
    [ "$(wc -l < "$clean")" -ge 15 ] || continue
    grep -qvE '^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$' "$clean" && continue
    mv -f "$clean" "$BASE_DIR/${cc}.cidr"
    logger -t countryallow "$cc 更新成功（來源:$srcname）"
    return 0
  done
  logger -t countryallow "$cc 更新失敗（主備皆不可用，沿用舊檔）"
  return 1
}

OK=0; FAIL=""
for cc in $SELECTED; do
  [ -z "$cc" ] && continue
  if fetch_one "$cc"; then OK=$((OK+1)); else FAIL="$FAIL $cc"; fi
done
logger -t countryallow "IP 集合抓取完成：成功 $OK 國，失敗:$FAIL"
[ -z "$FAIL" ]
