#!/bin/sh
# 41-luci-app-countryallow-ban: 初裝遷移（只跑一次）
# 舊獨立版（/root/luci-ban*.sh + rc.local）換手給 procd 服務
if [ -f /var/run/luci-ban-loop.pid ]; then
  oldpid=$(cat /var/run/luci-ban-loop.pid 2>/dev/null)
  [ -n "$oldpid" ] && kill "$oldpid" 2>/dev/null
  rm -f /var/run/luci-ban-loop.pid
fi
for p in $(ps | grep 'luci-ban-loop.sh' | grep -v grep | awk '{print $1}'); do kill "$p" 2>/dev/null; done
sed -i '/luci-ban-loop\.sh/d' /etc/rc.local 2>/dev/null
for f in /root/luci-ban.sh /root/luci-ban-loop.sh; do
  [ -f "$f" ] && mv "$f" "$f.bak"
done
chmod +x /usr/bin/countryallow-ban /usr/bin/countryallow-ban-status /usr/bin/countryallow-ban-unban /etc/init.d/luci-ban
/etc/init.d/luci-ban enable
/etc/init.d/luci-ban start
logger -t countryallow "ban migrated to procd"
/etc/init.d/firewall reload >/dev/null 2>&1
exit 0
