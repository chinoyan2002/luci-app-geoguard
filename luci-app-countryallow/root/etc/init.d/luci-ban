#!/bin/sh /etc/rc.common
# luci-ban procd 服務：每 N 秒跑一次 countryallow-ban（N 讀 UCI ban_interval）
USE_PROCD=1
START=99

start_service() {
  [ "$(uci get countryallow.main.ban_enabled 2>/dev/null)" = "0" ] && return 0
  IVAL=$(uci -q get countryallow.main.ban_interval 2>/dev/null)
  case "$IVAL" in ''|*[!0-9]*) IVAL=60 ;; esac
  [ "$IVAL" -lt 5 ] && IVAL=5
  [ "$IVAL" -gt 300 ] && IVAL=300
  procd_open_instance luci-ban
  procd_set_param command /bin/sh -c "while true; do /usr/bin/countryallow-ban; sleep $IVAL; done"
  procd_set_param respawn 5 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

reload_service() {
  stop
  start
}
