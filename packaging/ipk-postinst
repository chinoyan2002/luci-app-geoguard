#!/bin/sh
# luci-app-geoguard postinst (opkg/ipk): run our uci-defaults once now,
# then remove them (a factory-flashed image runs them at first boot instead).
[ -n "$IPKG_INSTROOT" ] && exit 0
for f in /etc/uci-defaults/40-luci-app-geoguard \
         /etc/uci-defaults/41-luci-app-geoguard-ban \
         /etc/uci-defaults/42-luci-app-geoguard-migrate; do
	[ -f "$f" ] || continue
	sh "$f"
	rm -f "$f"
done
exit 0
