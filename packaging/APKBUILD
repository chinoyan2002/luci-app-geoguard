# Maintainer: chinoyan <chinoyan2002@users.noreply.github.com>
pkgname=luci-app-geoguard
pkgver=2.3.0
pkgrel=2
pkgdesc="GeoGuard - country allow-list IPS with login guard for firewall4 (LuCI)"
url="https://github.com/chinoyan2002/luci-app-geoguard"
arch="noarch"
license="MIT"
# NOTE: busybox must stay listed: abuild force-adds an unresolvable /bin/sh
# dep to any package whose install script has a #!/bin/sh shebang, unless
# busybox (or /bin/sh) is already in depends (abuild:1184). /bin/sh is
# always present on OpenWrt via busybox.
depends="busybox luci-base firewall4 wget-ssl jsonfilter"
source="payload.tar.gz"
options="!strip !check !tracedeps"
install="luci-app-geoguard.post-install luci-app-geoguard.pre-deinstall"
subpackages="luci-i18n-geoguard-zh-tw:i18n_zhtw"

package() {
	mkdir -p "$pkgdir"
	cp -a "$srcdir"/luci-app-geoguard_2.3.0/* "$pkgdir"/
	rm -rf "$pkgdir"/CONTROL
}

i18n_zhtw() {
	pkgdesc="Traditional Chinese (Taiwan) translation for luci-app-geoguard"
	depends="luci-app-geoguard"
	mkdir -p "$subpkgdir"/usr/lib/lua/luci/i18n
	mv "$pkgdir"/usr/lib/lua/luci/i18n/geoguard.zh-tw.lmo \
		"$subpkgdir"/usr/lib/lua/luci/i18n/
}
