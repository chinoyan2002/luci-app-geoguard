# English translation for luci-app-geoguard
msgid ""
msgstr ""
"Project-Id-Version: luci-app-geoguard 1.1.0\n"
"Language: en\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "格式錯誤：請輸入單一 IP（如 203.0.113.10）、CIDR（如 203.0.113.0/24）或範圍（如 203.0.113.10-203.0.113.50）"
msgstr "Invalid format: enter a single IP (e.g. 203.0.113.10), CIDR (e.g. 203.0.113.0/24) or range (e.g. 203.0.113.10-203.0.113.50)"

msgid "目前啟用的集合：尚無資料"
msgstr "Active set: no data yet"

msgid "目前啟用：%s.cidr（%s 行／live %s 段／更新於 %s）"
msgstr "Active: %s.cidr (%s lines / %s live entries / updated %s)"

msgid "勾選國家＋白名單 IP，合併成集合檔。本頁只生產 IP 集合，不動防火牆。"
msgstr "Select countries + whitelist IPs, merged into sets. This page only builds IP sets, never touches the firewall."

msgid "設定"
msgstr "Settings"

msgid "登入防護"
msgstr "Login Guard"

msgid "IPs 設定"
msgstr "IP Sets"

msgid "記錄"
msgstr "Log"

msgid "已勾選："
msgstr "Selected: "

msgid "（尚未勾選）"
msgstr "(none selected)"

msgid "搜尋，如 TW 台灣 TAIWAN"
msgstr "Search, e.g. TW 台灣 TAIWAN"

msgid "清除"
msgstr "Clear"

msgid "全選"
msgstr "Select all"

msgid "清除已選"
msgstr "Clear selected"

msgid "編碼"
msgstr "Code"

msgid "位置"
msgstr "Location"

msgid "選擇國家"
msgstr "Select countries"

msgid "刪除"
msgstr "Delete"

msgid "新增"
msgstr "Add"

msgid "除國家外要包含的 白名單：IP / CIDR / 範圍"
msgstr "Whitelist beyond countries: IP / CIDR / Range"

msgid "格式：單一 IP、CIDR、A-B 範圍。國家全空＋有 IP＝純白名單。"
msgstr "Formats: single IP, CIDR, A-B range. No country + IPs = pure whitelist."

msgid "主要訂閱源"
msgstr "Primary feed"

msgid "{cc} 會換成國碼小寫，{CC} 大寫。"
msgstr "{cc} becomes the lowercase code, {CC} uppercase."

msgid "備用訂閱源"
msgstr "Backup feed"

msgid "失敗改抓備用；抓不到沿用舊檔。"
msgstr "Falls back on failure; keeps the old file if both fail."

msgid "多國家+自訂白名單IP的總集合名稱"
msgstr "Merged set name (countries + custom whitelist)"

msgid "只允許英文開頭，後接英文數字底線連字號"
msgstr "Must start with a letter, followed by letters, digits, _ or -"

msgid "規則：英文開頭，僅英文數字底線連字號。檔名與 set 同名；改名舊檔保留。"
msgstr "Rule: start with a letter; letters/digits/_/- only. File shares the set name; old file kept after rename."

msgid "白名單集合名稱"
msgstr "Whitelist set name"

msgid "白名單獨立成一個集合，防火牆 IP 集合頁可見，規則同上。"
msgstr "Whitelist lives in its own set, visible under Firewall IP Sets. Same rules as above."

msgid "每天"
msgstr "Daily"

msgid "每週日"
msgstr "Weekly (Sun)"

msgid "每月 1 日"
msgstr "Monthly (1st)"

msgid "自動更新清單頻率"
msgstr "Auto-update schedule"

msgid "時"
msgstr "Hour"

msgid "分"
msgstr "Minute"

msgid "啟用自動更新"
msgstr "Enable auto-update"

msgid "本頁只負責產生 IP 集合檔，不動防火牆任何規則。"
msgstr "This page only builds IP set files and never changes firewall rules."

msgid "生效方式：網路→防火牆→連接埠轉發→新增→進階設定→IPSet 下拉選集合，存檔套用。"
msgstr "Apply: Network → Firewall → Port Forwards → Add → Advanced → pick the set in IPSet, then Save & Apply."

msgid "備用（SSH）：uci set firewall.@redirect[N].ipset＝集合名稱，commit 後 fw4 reload。"
msgstr "Fallback (SSH): uci set firewall.@redirect[N].ipset=set name, commit, then fw4 reload."

msgid "集合名稱不合規格（英文字母開頭，僅英文數字底線連字號），設定已存檔但不會執行更新"
msgstr "Bad set name (must start with a letter: letters/digits/_/- only). Settings saved, update skipped."

msgid "更新失敗：%s"
msgstr "Update failed: %s"

msgid "未知錯誤"
msgstr "unknown error"

msgid "執行失敗：%s"
msgstr "Failed: %s"

msgid "立即更新 IP 集合"
msgstr "Update IP Sets Now"

msgid "立即更新並合併"
msgstr "Update and Merge Now"

msgid "儲存設定"
msgstr "Save Settings"

msgid "清除更新歷史"
msgstr "Clear Update History"

msgid "更新歷史已清除"
msgstr "Update history cleared"

msgid "啟用登入防護"
msgstr "Enable login guard"

msgid "關閉即停掉防護服務，已封鎖的不自動解封。"
msgstr "Disabling stops the guard service; active bans stay until expiry."

msgid "失敗幾次封鎖"
msgstr "Fails to ban"

msgid "時間窗（分鐘）"
msgstr "Window (min)"

msgid "封鎖多久（小時）"
msgstr "Ban time (hours)"

msgid "防護 LuCI 網頁登入"
msgstr "Guard LuCI web login"

msgid "防護 SSH 登入"
msgstr "Guard SSH login"

msgid "永久免封清單"
msgstr "Permanent allowlist"

msgid "請輸入 IP 或 CIDR（如 192.168.0.0/16）"
msgstr "Enter an IP or CIDR (e.g. 192.168.0.0/16)"

msgid "此清單內的 IP／網段永久免於封鎖。系統預設已含保留位址與內網段。另有兩類自動免封，無需在此重複填寫：IP 白名單（IPs 設定籤）與 DDNS 白名單（本籤下方），後者 IP 變動時自動跟隨。"
msgstr "IPs/subnets here are never banned. Defaults already cover reserved and private ranges. Two more auto-exempt sources need no entry here: IP whitelist (IP Sets tab) and DDNS whitelist (below), whose IPs follow automatically."

msgid "DDNS 白名單清單"
msgstr "DDNS allowlist"

msgid "請輸入合法網域名稱（如 home.example.org）"
msgstr "Enter a valid domain (e.g. home.example.org)"

msgid "可新增多筆；每筆獨立追 IP。本清單只適用防護免封，不動 IP 集合。"
msgstr "Add multiple entries; each tracked separately. For guard exemption only; never touches IP sets."

msgid "DDNS 檢查間隔（分鐘）"
msgstr "DDNS check interval (min)"

msgid "巡邏間隔（秒）"
msgstr "Scan interval (sec)"

msgid "外網介面（自動偵測）"
msgstr "WAN interface (auto-detect)"

msgid "介面名稱格式錯誤"
msgstr "Bad interface name"

msgid "留空自動偵測（firewall wan 區→系統→預設路由）。只有自動偵測失靈才手填（如 pppoe-wan）。"
msgstr "Leave empty to auto-detect (firewall wan zone → system → default route). Fill in manually only if detection fails (e.g. pppoe-wan)."

msgid "被封鎖＝整台對他消失：外網進來的所有封包（所有 port、TCP/UDP/ICMP）在源頭全丟，%s 小時自動解封。"
msgstr "Banned = invisible: every packet from the WAN (all ports, TCP/UDP/ICMP) is dropped at ingress, auto-released after %s hours."

msgid "狀態載入中…"
msgstr "Loading status…"

msgid "防護設定已儲存並重啟"
msgstr "Guard settings saved and restarted"

msgid "重啟防護失敗：%s"
msgstr "Guard restart failed: %s"

msgid "已全部解封"
msgstr "All unbanned"

msgid "儲存防護設定並重啟"
msgstr "Save & Restart Guard"

msgid "全部解封"
msgstr "Unban All"

msgid "GeoGuard"
msgstr "GeoGuard"
msgid "國門守衛 GeoGuard Ver:"
msgstr "GeoGuard Ver:"

