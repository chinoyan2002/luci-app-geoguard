#!/bin/sh
# geoguard schedule manager: daily / weekly (Sun) / monthly (1st) + hour:min
# (takes effect after one run on UCI change)
CRON_FILE="/etc/crontabs/root"
JOB="/usr/bin/geoguard-update"

sed -i '\#geoguard-update#d' "$CRON_FILE" 2>/dev/null
sed -i '\#geoguard-ddns#d' "$CRON_FILE" 2>/dev/null

BASE_DIR="/etc/luci-uploads"
# Cron trailing comments follow the LuCI system language.
# WARNING: the four NOTE_* lines have identical copies in geoguard-ddns;
# both sides must match byte-for-byte, otherwise the ddns self-heal line
# comparison never matches and rewrites+reloads cron every round.
# (NOTE_*_ZH values are locale data picked by gg_cron_lang, not code comments.)
NOTE_DDNS_ZH='# 國門守衛 DDNS 白名單追蹤（自動管理，請勿手改）'
NOTE_DDNS_EN='# GeoGuard DDNS whitelist tracker (auto-managed, do not edit)'
NOTE_UPDATE_ZH='# 國門守衛 IP 集合更新（自動管理，請勿手改）'
NOTE_UPDATE_EN='# GeoGuard country IP sets updater (auto-managed, do not edit)'
gg_cron_lang() {
  case "$(uci -q get luci.main.lang 2>/dev/null)" in
    zh*) echo 'zh' ;;
    *) echo 'en' ;;
  esac
}
# DDNS whitelist: static line always present (no save path removes it;
# script exits fast when the list is empty).
# Interval read from UCI (default 30 min); list empty but state non-empty
# means just cleared -> run one purge.
DDNS_I=$(uci -q get geoguard.main.ddns_interval 2>/dev/null)
case "$DDNS_I" in ''|*[!0-9]*) DDNS_I=30 ;; esac
[ "$DDNS_I" -lt 1 ] && DDNS_I=1
[ "$DDNS_I" -gt 60 ] && DDNS_I=60
if [ "$(gg_cron_lang)" = 'zh' ]; then
  DNOTE="$NOTE_DDNS_ZH"; UNOTE="$NOTE_UPDATE_ZH"
else
  DNOTE="$NOTE_DDNS_EN"; UNOTE="$NOTE_UPDATE_EN"
fi
echo "*/$DDNS_I * * * * /usr/bin/geoguard-ddns $DNOTE" >> "$CRON_FILE"
/usr/bin/geoguard-ddns

if [ "$(uci -q get geoguard.main.auto_update)" = "1" ]; then
	FREQ=$(uci -q get geoguard.main.update_freq 2>/dev/null)
	HOUR=$(uci -q get geoguard.main.update_hour)
	MIN=$(uci -q get geoguard.main.update_min)
	[ -z "$HOUR" ] && HOUR=3
	[ -z "$MIN" ] && MIN=10
	case "$FREQ" in
		weekly)  SPEC="$MIN $HOUR * * 0" ;;
		monthly) SPEC="$MIN $HOUR 1 * *" ;;
		*)       SPEC="$MIN $HOUR * * *" ;;
	esac
	echo "$SPEC $JOB $UNOTE" >> "$CRON_FILE"
	logger -t geoguard "schedule set: $SPEC"
else
	logger -t geoguard "auto update disabled"
fi

/etc/init.d/cron restart >/dev/null 2>&1
