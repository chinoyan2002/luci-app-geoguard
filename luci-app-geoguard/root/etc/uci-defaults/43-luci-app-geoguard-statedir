#!/bin/sh
# 43-luci-app-geoguard-statedir: move state from the pre-2.2.1 shared directory
# to the package-owned one (runs once at install/upgrade via postinst).
OLD_DIR="/etc/luci-uploads"
NEW_DIR="/etc/geoguard"
mkdir -p "$NEW_DIR"
for f in "$OLD_DIR"/*.cidr "$OLD_DIR"/ban-persist.list \
         "$OLD_DIR"/ddns-allowlist.list "$OLD_DIR"/history.log \
         "$OLD_DIR"/cc-en.txt; do
  [ -e "$f" ] || continue
  if [ -s "$NEW_DIR/${f##*/}" ]; then
    [ "${f##*/}" = "history.log" ] || rm -f "$f" 2>/dev/null
  else
    mv -f "$f" "$NEW_DIR/" 2>/dev/null
  fi
done
# history.log: prepend stranded old entries (chronological) instead of stranding them
if [ -s "$OLD_DIR/history.log" ] && [ -s "$NEW_DIR/history.log" ]; then
  cat "$OLD_DIR/history.log" "$NEW_DIR/history.log" > "$NEW_DIR/history.log.new" 2>/dev/null \
    && mv -f "$NEW_DIR/history.log.new" "$NEW_DIR/history.log" 2>/dev/null \
    && rm -f "$OLD_DIR/history.log" 2>/dev/null
fi
# stale shipped copy from old packages (new packages ship it under NEW_DIR)
rm -f "$OLD_DIR/cc-en.txt" 2>/dev/null
# Firewall follow-up: sections pointing at the old dir brick every fw4
# reload (nft -f aborts atomically on a missing loadfile, yet fw4 still
# exits 0), so no ruleset change ever lands again. For each stale section:
# data moved -> repoint; data exists nowhere and unreferenced -> delete;
# data exists nowhere but still referenced -> keep + loud error (same H1
# policy as geoguard-update: never silently break a live rule).
# Descending index order: deleting renumbers anonymous sections, so acting
# top-down would skip entries (same rule as the update sweep).
for sec in $(uci show firewall 2>/dev/null | grep -F "loadfile='$OLD_DIR/" | cut -d= -f1 | sort -t'[' -k2 -rn); do
  _old=$(uci -q get "$sec" 2>/dev/null)
  _new="$NEW_DIR/${_old##*/}"
  if [ -s "$_new" ]; then
    uci set "$sec" "$_new" 2>/dev/null && REPOINTED=1
  elif [ -e "$_old" ]; then
    : # still loadable where it is; leave working config alone
  elif uci show firewall 2>/dev/null | grep -q "\.ipset='$(uci -q get "${sec%.loadfile}.name" 2>/dev/null)'$"; then
    logger -t geoguard "ERROR stale set ${sec%.loadfile} still referenced by rules but data is gone (re-bind rules or run update-merge)"
  else
    uci delete "${sec%.loadfile}" 2>/dev/null && REPOINTED=1
    logger -t geoguard "stale section removed: ${sec%.loadfile} (data gone with $OLD_DIR)"
  fi
done
if [ "$REPOINTED" = "1" ]; then
  uci commit firewall 2>/dev/null
  logger -t geoguard "statedir moved, firewall loadfiles repointed to $NEW_DIR"
fi
exit 0
